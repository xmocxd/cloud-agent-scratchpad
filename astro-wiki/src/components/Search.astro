---
interface SearchItem {
	id: string;
	title: string;
	description: string;
	href: string;
	order: number;
	body: string;
}

interface Props {
	index: SearchItem[];
}

const { index } = Astro.props;
---

<div class="search" data-search>
	<label class="nav-label" for="wiki-search">Search</label>
	<input
		id="wiki-search"
		type="search"
		placeholder="Search chapters…"
		autocomplete="off"
		data-search-input
	/>
	<ul class="search-results" data-search-results hidden></ul>
</div>

<script define:vars={{ index }}>
	const root = document.querySelector('[data-search]');
	const input = root?.querySelector('[data-search-input]');
	const results = root?.querySelector('[data-search-results]');
	if (!root || !input || !results) throw new Error('Search UI missing');

	const items = index.map((item) => ({
		...item,
		haystack: `${item.title} ${item.description} ${item.body}`.toLowerCase(),
	}));

	function render(query) {
		const q = query.trim().toLowerCase();
		if (!q) {
			results.innerHTML = '';
			results.dataset.open = 'false';
			results.hidden = true;
			return;
		}

		const matches = items
			.filter((item) => item.haystack.includes(q))
			.slice(0, 8);

		if (matches.length === 0) {
			results.innerHTML = `<li class="search-empty">No chapters match “${query.trim()}”.</li>`;
		} else {
			results.innerHTML = matches
				.map(
					(item) => `
						<li>
							<a href="${item.href}">
								<strong>${item.title}</strong>
								<span class="meta">Chapter ${String(item.order).padStart(2, '0')}${item.description ? ` · ${item.description}` : ''}</span>
							</a>
						</li>
					`,
				)
				.join('');
		}

		results.hidden = false;
		results.dataset.open = 'true';
	}

	input.addEventListener('input', () => render(input.value));
	input.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			input.value = '';
			render('');
			input.blur();
		}
	});

	document.addEventListener('click', (event) => {
		if (!root.contains(event.target)) {
			results.dataset.open = 'false';
			results.hidden = true;
		}
	});
</script>
